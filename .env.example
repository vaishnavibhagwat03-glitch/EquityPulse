# EquityPulse configuration. Copy to .env.local to override locally.
# Nothing here is secret: the app needs no API keys.

# WebSocket market feed. When set, the client connects to the `ws` feed server
# (npm run feed, default ws://localhost:4001). When empty, the same feed protocol
# runs inside a Web Worker in the browser, so deployments without a socket server
# (e.g. Vercel) still stream.
NEXT_PUBLIC_FEED_URL=

# Feed server port (server/feed-server.ts).
FEED_PORT=4001

# Public base URL used for metadata, robots.txt and the sitemap.
# On Vercel it defaults to the production domain; locally to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=
