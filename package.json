{
  "name": "equitypulse",
  "version": "1.0.0",
  "private": true,
  "description": "EquityPulse — real-time stock intelligence for 5,000+ simulated NSE/BSE securities.",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "concurrently -k -n feed,web -c magenta,blue \"npm:feed\" \"npm:dev:ws\"",
    "dev:web": "next dev",
    "dev:ws": "cross-env NEXT_PUBLIC_FEED_URL=ws://localhost:4001 next dev",
    "feed": "tsx server/feed-server.ts",
    "build": "next build",
    "start": "next start",
    "start:all": "concurrently -k -n feed,web -c magenta,blue \"npm:feed\" \"npm:start\"",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:perf": "vitest run tests/performance",
    "perf:measure": "node scripts/measure-runtime.mjs",
    "perf:lighthouse": "node scripts/run-lighthouse.mjs",
    "verify": "npm run typecheck && npm run lint && npm run test",
    "prepare": "husky"
  },
  "dependencies": {
    "@tanstack/query-async-storage-persister": "5.104.0",
    "@tanstack/react-query": "5.104.0",
    "@tanstack/react-query-persist-client": "5.104.0",
    "@tanstack/react-table": "8.21.3",
    "@tanstack/react-virtual": "3.14.13",
    "idb-keyval": "6.3.0",
    "lightweight-charts": "5.2.1",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "web-vitals": "6.2.2",
    "ws": "8.22.0",
    "zod": "4.6.5",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "6.10.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "5.2.0",
    "@vitest/coverage-v8": "4.1.11",
    "concurrently": "10.0.5",
    "cross-env": "10.1.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "eslint-config-prettier": "10.1.8",
    "husky": "9.1.7",
    "jsdom": "26.1.0",
    "lighthouse": "13.5.0",
    "lint-staged": "17.6.0",
    "playwright-core": "1.63.0",
    "prettier": "3.9.9",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
